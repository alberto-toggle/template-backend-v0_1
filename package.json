{
  "name": "microservice-name",
  "version": "0.1.0",
  "description": "Microservice boilerplate with Node.js, Fastify, TypeScript, Prisma, and SQL Server",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "22.22.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env --watch --tsconfig tsconfig.json src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . --config eslint.config.js --ext .ts",
    "format": "prettier --config .prettierrc.cjs --write .",
    "test": "node --env-file=.env node_modules/jest/bin/jest.js --config jest.config.ts",
    "test:watch": "node --env-file=.env node_modules/jest/bin/jest.js --watch --config jest.config.ts",
    "test:coverage": "node --env-file=.env node_modules/jest/bin/jest.js --coverage --config jest.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@fastify/swagger": "9.6.1",
    "@fastify/swagger-ui": "5.2.5",
    "@prisma/client": "6.19.2",
    "ajv": "8.17.1",
    "fastify": "5.7.4",
    "pino": "10.3.0",
    "undici": "7.20.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "25.2.1",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "jest": "30.2.0",
    "pino-pretty": "^13.0.0",
    "prettier": "3.8.1",
    "prisma": "6.19.2",
    "ts-jest": "29.4.6",
    "tsc-alias": "1.8.16",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "glob": "13.0.0",
    "test-exclude": "7.0.1"
  }
}
