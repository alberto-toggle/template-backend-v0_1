{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "baseUrl": "..",
    "paths": {
      "@src/*": ["src/*"]
    },
    "rootDir": "../src",
    "outDir": "../dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["../src/**/*.ts"],
  "exclude": ["../node_modules", "../dist", "../tests", "../prisma"]
}
